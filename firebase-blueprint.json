{
  "entities": {
    "RtlDesign": {
      "title": "RTL Design",
      "description": "User-authored Verilog RTL module and synthesis constraints",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "description": "Module / design title"
        },
        "description": {
          "type": "string",
          "description": "Short architectural description"
        },
        "verilogCode": {
          "type": "string",
          "description": "Synthesizable Verilog HDL source"
        },
        "targetLibrary": {
          "type": "string",
          "enum": ["ASAP7_7NM", "SKY130_130NM", "ARTIX7_FPGA"],
          "description": "Target standard cell or FPGA technology library"
        },
        "optimizationGoal": {
          "type": "string",
          "enum": ["BALANCED", "MIN_AREA", "MIN_DELAY"],
          "description": "Synthesis optimization strategy"
        },
        "clockPeriodNs": {
          "type": "number",
          "description": "Target clock period constraint in nanoseconds"
        },
        "lastWnsNs": {
          "type": "number",
          "description": "Last synthesized Worst Negative Slack in nanoseconds"
        },
        "lastAreaUm2": {
          "type": "number",
          "description": "Last synthesized cell area in square micrometers"
        },
        "lastCellCount": {
          "type": "integer",
          "description": "Last synthesized total mapped cell count"
        },
        "lastPowerMw": {
          "type": "number",
          "description": "Last estimated total power in milliwatts"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "name",
        "description",
        "verilogCode",
        "targetLibrary",
        "optimizationGoal",
        "clockPeriodNs",
        "lastWnsNs",
        "lastAreaUm2",
        "lastCellCount",
        "lastPowerMw",
        "createdAt",
        "updatedAt"
      ]
    },
    "SynthesisRun": {
      "title": "Synthesis Run",
      "description": "Immutable snapshot of a completed RTL synthesis run for PPA comparison",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "designId": {
          "type": "string",
          "description": "Parent RtlDesign document ID"
        },
        "designName": {
          "type": "string",
          "description": "Name of synthesized RTL module"
        },
        "targetLibrary": {
          "type": "string",
          "enum": ["ASAP7_7NM", "SKY130_130NM", "ARTIX7_FPGA"],
          "description": "Target technology library used for mapping"
        },
        "optimizationGoal": {
          "type": "string",
          "enum": ["BALANCED", "MIN_AREA", "MIN_DELAY"],
          "description": "Optimization goal used during synthesis"
        },
        "clockPeriodNs": {
          "type": "number",
          "description": "Target clock period constraint in ns"
        },
        "fmaxMhz": {
          "type": "number",
          "description": "Achieved maximum clock frequency in MHz"
        },
        "wnsNs": {
          "type": "number",
          "description": "Worst Negative Slack in ns"
        },
        "tnsNs": {
          "type": "number",
          "description": "Total Negative Slack in ns"
        },
        "areaUm2": {
          "type": "number",
          "description": "Total mapped area in um^2"
        },
        "cellCount": {
          "type": "integer",
          "description": "Total standard cells or FPGA primitives"
        },
        "lutCount": {
          "type": "integer",
          "description": "Mapped combinational gates or LUT count"
        },
        "dffCount": {
          "type": "integer",
          "description": "Mapped sequential flip-flop register count"
        },
        "powerMw": {
          "type": "number",
          "description": "Estimated total dynamic and leakage power in mW"
        },
        "criticalPathSummary": {
          "type": "string",
          "description": "Human-readable critical path node chain"
        },
        "netlistVerilog": {
          "type": "string",
          "description": "Synthesized structural gate-level Verilog netlist"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "designId",
        "designName",
        "targetLibrary",
        "optimizationGoal",
        "clockPeriodNs",
        "fmaxMhz",
        "wnsNs",
        "tnsNs",
        "areaUm2",
        "cellCount",
        "lutCount",
        "dffCount",
        "powerMw",
        "criticalPathSummary",
        "netlistVerilog",
        "createdAt"
      ]
    },
    "RtlWorkspaceDraft": {
      "title": "RTL Workspace Auto-Save Draft",
      "description": "Periodically auto-saved active editor project state for unexpected interruption recovery",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "activeCloudDesignId": {
          "type": "string",
          "description": "Linked RtlDesign document ID if editing a saved design, otherwise empty string"
        },
        "designName": {
          "type": "string",
          "description": "Active module / design title"
        },
        "description": {
          "type": "string",
          "description": "Short architectural description"
        },
        "verilogCode": {
          "type": "string",
          "description": "Active Verilog HDL editor source"
        },
        "sdcText": {
          "type": "string",
          "description": "Active Synopsys Design Constraints (SDC) text"
        },
        "targetLibrary": {
          "type": "string",
          "enum": ["ASAP7_7NM", "SKY130_130NM", "ARTIX7_FPGA"],
          "description": "Target standard cell or FPGA technology library"
        },
        "optimizationGoal": {
          "type": "string",
          "enum": ["BALANCED", "MIN_AREA", "MIN_DELAY"],
          "description": "Synthesis optimization strategy"
        },
        "clockPeriodNs": {
          "type": "number",
          "description": "Target clock period constraint in nanoseconds"
        },
        "lastWnsNs": {
          "type": "number",
          "description": "Last synthesized Worst Negative Slack in nanoseconds"
        },
        "lastAreaUm2": {
          "type": "number",
          "description": "Last synthesized cell area in square micrometers"
        },
        "lastCellCount": {
          "type": "integer",
          "description": "Last synthesized total mapped cell count"
        },
        "lastPowerMw": {
          "type": "number",
          "description": "Last estimated total power in milliwatts"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "activeCloudDesignId",
        "designName",
        "description",
        "verilogCode",
        "sdcText",
        "targetLibrary",
        "optimizationGoal",
        "clockPeriodNs",
        "lastWnsNs",
        "lastAreaUm2",
        "lastCellCount",
        "lastPowerMw",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/designs/{designId}": {
      "schema": { "$ref": "#/entities/RtlDesign" },
      "description": "User-owned RTL Verilog designs and synthesis settings"
    },
    "/users/{userId}/synthesisRuns/{runId}": {
      "schema": { "$ref": "#/entities/SynthesisRun" },
      "description": "User-owned historical synthesis PPA snapshots"
    },
    "/users/{userId}/workspace/{draftId}": {
      "schema": { "$ref": "#/entities/RtlWorkspaceDraft" },
      "description": "User-owned periodic workspace auto-save snapshot"
    }
  }
}
